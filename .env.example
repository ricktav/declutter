# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# DATABASE_URL=mysql://user:password@host:3306/dbname

# ---------------------------------------------------------------------------
# LLM provider (optional — AI features degrade gracefully without it)
# Any OpenAI-compatible endpoint works. Examples:
#
#   xAI Grok:
#     LLM_BASE_URL=https://api.x.ai/v1
#     LLM_API_KEY=xai-...
#     LLM_MODEL=grok-4.6
#     LLM_VISION_MODEL=grok-4.6
#
#   Local Ollama (e.g. on a Mac mini — vision keeps photos private):
#     LLM_BASE_URL=http://192.168.x.x:11434/v1
#     LLM_API_KEY=ollama            # any non-empty string; Ollama ignores it
#     LLM_MODEL=llama3.1
#     LLM_VISION_MODEL=qwen2.5vl
#
#   OpenAI:
#     LLM_BASE_URL=https://api.openai.com/v1
#     LLM_API_KEY=sk-...
#     LLM_MODEL=gpt-4.1
# ---------------------------------------------------------------------------
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_VISION_MODEL=

# --- Optional second provider (Provider B), for A/B comparison only.
#     Every inbox capture gets an "A/B" button that runs the same prompt on
#     both providers side by side. Base URL must be the API root only —
#     no /chat/completions suffix (the SDK appends it).
#     e.g. OpenRouter:
#     LLM2_BASE_URL=https://openrouter.ai/api/v1
#     LLM2_API_KEY=sk-or-...
#     LLM2_MODEL=openai/gpt-4o
# LLM2_BASE_URL=
# LLM2_API_KEY=
# LLM2_MODEL=
